# BK Centre Connect Environment Variables
# Copy this file to .env.local and update with your actual project keys

# Supabase Public Configuration
# Used by both browser and server client instances
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Note: Never expose Supabase service-role keys to client-side code.
